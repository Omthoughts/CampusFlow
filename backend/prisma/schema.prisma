generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Year {
  FY
  SY
}

enum Division {
  A
  B
}

enum Batch {
  F1
  F2
  F3
}

enum NoticeCategory {
  EXAM
  ACADEMIC
  EVENT
  GENERAL
}

enum NoticePriority {
  URGENT
  HIGH
  NORMAL
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum DeadlineType {
  EXAM
  SUBMISSION
}

model Department {
  id    String @id @default(uuid())
  name  String
  code  String @unique
  users User[]
}

model User {
  id                 String         @id @default(uuid())
  name               String
  email              String         @unique
  passwordHash       String
  role               Role           @default(STUDENT)
  status             UserStatus     @default(ACTIVE)
  mustChangePassword Boolean        @default(true)
  departmentId       String?
  department         Department?    @relation(fields: [departmentId], references: [id])
  year               Year?
  division           Division?
  batch              Batch?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  registrations      Registration[]
  notices            Notice[]
  events             Event[]
  deadlines          Deadline[]
  notifications      Notification[]
  auditLogs          AuditLog[]
}

model Notice {
  id          String           @id @default(uuid())
  title       String
  content     String
  category    NoticeCategory
  priority    NoticePriority   @default(NORMAL)
  status      NoticeStatus     @default(DRAFT)
  publishedAt DateTime?
  authorId    String
  author      User             @relation(fields: [authorId], references: [id])
  sourceUrl   String?
  rawFileHash String?          @unique
  audiences   NoticeAudience[]
  summary     NoticeSummary?
  attachments Attachment[]
}

model NoticeAudience {
  id           String      @id @default(uuid())
  noticeId     String
  notice       Notice      @relation(fields: [noticeId], references: [id])
  departmentId String?
  year         Year?
  division     Division?
  batch        Batch?

  // We can uniquely identify an audience rule for a notice by these constraints.
  // Prisma requires unique constraint for all nullable fields to have a specific behavior,
  // but it's acceptable for logic.
  @@unique([noticeId, departmentId, year, division, batch])
}

model NoticeSummary {
  noticeId       String    @id
  notice         Notice    @relation(fields: [noticeId], references: [id])
  whatChanged    String
  whoAffected    String
  requiredAction String?
  deadline       DateTime?
  rawAIResponse  Json?
}

model Event {
  id                   String         @id @default(uuid())
  title                String
  description          String
  date                 DateTime
  venue                String
  capacity             Int?
  registrationDeadline DateTime?
  status               EventStatus    @default(DRAFT)
  createdById          String
  createdBy            User           @relation(fields: [createdById], references: [id])
  registrations        Registration[]
}

model Registration {
  id           String             @id @default(uuid())
  eventId      String
  event        Event              @relation(fields: [eventId], references: [id])
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  status       RegistrationStatus @default(CONFIRMED)
  registeredAt DateTime           @default(now())

  @@unique([eventId, userId])
}

model Deadline {
  id          String       @id @default(uuid())
  title       String
  description String?
  dueAt       DateTime
  type        DeadlineType
  subject     String?
  status      NoticeStatus @default(PUBLISHED)
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Attachment {
  id         String @id @default(uuid())
  storageKey String
  filename   String
  mimeType   String
  size       Int
  noticeId   String
  notice     Notice @relation(fields: [noticeId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}
