generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id    String @id @default(uuid())
  name  String
  code  String @unique
  users User[]
}

model User {
  id                 String         @id @default(uuid())
  name               String
  email              String         @unique
  passwordHash       String
  role               Role           @default(STUDENT)
  status             UserStatus     @default(ACTIVE)
  mustChangePassword Boolean        @default(true)
  departmentId       String?
  year               Year?
  division           Division?
  batch              Batch?
  studentId          String?        @unique
  course             String?
  rollNumber         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  auditLogs          AuditLog[]
  deadlines          Deadline[]
  events             Event[]
  notices            Notice[]
  notifications      Notification[]
  registrations      Registration[]
  department         Department?    @relation(fields: [departmentId], references: [id])
}

model Notice {
  id              String           @id @default(uuid())
  title           String
  content         String
  category        NoticeCategory
  priority        NoticePriority   @default(NORMAL)
  status          NoticeStatus     @default(DRAFT)
  publishedAt     DateTime?
  authorId        String
  sourceUrl       String?
  rawFileHash     String?          @unique
  isAiGenerated   Boolean          @default(false)
  isHumanVerified Boolean          @default(false)
  attachments     Attachment[]
  author          User             @relation(fields: [authorId], references: [id])
  audiences       NoticeAudience[]
  summary         NoticeSummary?
}

model NoticeAudience {
  id           String    @id @default(uuid())
  noticeId     String
  departmentId String?
  year         Year?
  division     Division?
  batch        Batch?
  notice       Notice    @relation(fields: [noticeId], references: [id])

  @@unique([noticeId, departmentId, year, division, batch])
}

model NoticeSummary {
  noticeId       String    @id
  whatChanged    String
  whoAffected    String
  requiredAction String?
  deadline       DateTime?
  rawAIResponse  Json?
  evidence       Json?
  sourcePages    String?
  notice         Notice    @relation(fields: [noticeId], references: [id])
}

model Event {
  id                   String         @id @default(uuid())
  title                String
  description          String
  date                 DateTime
  venue                String
  capacity             Int?
  registrationDeadline DateTime?
  status               EventStatus    @default(DRAFT)
  createdById          String
  createdBy            User           @relation(fields: [createdById], references: [id])
  registrations        Registration[]
}

model Registration {
  id           String             @id @default(uuid())
  eventId      String
  userId       String
  status       RegistrationStatus @default(CONFIRMED)
  registeredAt DateTime           @default(now())
  event        Event              @relation(fields: [eventId], references: [id])
  user         User               @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model Deadline {
  id                     String       @id @default(uuid())
  title                  String
  description            String?
  dueAt                  DateTime
  type                   DeadlineType
  subject                String?
  status                 NoticeStatus @default(PUBLISHED)
  createdById            String
  academicItemIdentifier String?
  createdBy              User         @relation(fields: [createdById], references: [id])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Attachment {
  id         String @id @default(uuid())
  storageKey String
  filename   String
  mimeType   String
  size       Int
  noticeId   String
  notice     Notice @relation(fields: [noticeId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Year {
  FY
  SY
}

enum Division {
  A
  B
}

enum Batch {
  F1
  F2
  F3
}

enum NoticeCategory {
  EXAM
  ACADEMIC
  EVENT
  GENERAL
}

enum NoticePriority {
  URGENT
  HIGH
  NORMAL
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum DeadlineType {
  EXAM
  SUBMISSION
}
